import React, { useState, useCallback, useMemo, useEffect, useRef } from 'react';
import { 
  Plus, Trash2, CheckCircle2, Circle, 
  Target, Settings2,
  X, Printer as LucidePrinter,
  ChevronRight, ArrowRight, ChevronRightSquare, ChevronDownSquare, ChevronDown as LucideChevronDown,
  Layers, ZoomIn, ZoomOut, Maximize2, Inbox, Clock,
  Edit3, ChevronLeft, CalendarDays, MousePointer2, Flag, HelpCircle,
  Layout, AlignLeft, LayoutGrid, ListTodo, Calendar as LucideCalendar, ExternalLink, Check, Keyboard as LucideKeyboard
} from 'lucide-react';

// --- 1. 定数とユーティリティ ---

const STORAGE_KEY = 'biz_flow_v10_final_outline';

const getTodayISO = () => new Date().toISOString().split('T')[0];
const TODAY_ISO = getTodayISO();

const formatDateM = (iso) => {
  if (!iso || iso === 'none') return '未設定';
  const d = new Date(iso);
  return `${d.getMonth() + 1}/${d.getDate()}`;
};

const getWeeklyDates = () => {
  const days = [];
  const labels = ['日', '月', '火', '水', '木', '金', '土'];
  const today = new Date();
  for (let i = 0; i < 7; i++) {
    const d = new Date(today);
    d.setDate(today.getDate() + i);
    days.push({ 
      id: d.toISOString().split('T')[0], 
      label: `${d.getMonth() + 1}/${d.getDate()}`, 
      sub: labels[d.getDay()] 
    });
  }
  return days;
};

const WEEKLY_DAYS = getWeeklyDates();

const generateId = (pfx) => `${pfx}-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`;

// --- 2. 初期データ ---

const initialData = [
  {
    id: generateId('root'),
    text: 'A社 売上改善プロジェクト',
    type: 'issue',
    completed: false,
    deadline: null,
    isRoot: true,
    collapsed: false,
    children: [
      {
        id: generateId('node'),
        text: 'どうすればA社の売り上げを改善できるか？',
        type: 'issue',
        completed: false,
        deadline: null,
        collapsed: false,
        children: [
          {
            id: generateId('node'),
            text: '既存顧客へのアップセル施策',
            type: 'task',
            completed: false,
            deadline: TODAY_ISO,
            doneDefinition: '価格改定案の作成',
            children: []
          }
        ]
      }
    ]
  }
];

// --- 3. UIコンポーネント: サイドバー ---

const Sidebar = ({ current, onSet }) => {
  const items = [
    { id: 'tree', icon: <LayoutGrid size={24} />, label: '構造 (A)' },
    { id: 'list', icon: <ListTodo size={24} />, label: '週間 (B)' },
    { id: 'monthly', icon: <LucideCalendar size={24} />, label: '月間 (C)' },
  ];

  return (
    <div className="w-16 h-full bg-slate-900 flex flex-col items-center py-6 gap-6 shrink-0 z-50">
      {items.map(item => (
        <button
          key={item.id}
          onClick={() => onSet(item.id)}
          className={`relative p-3 rounded-xl transition-all group ${current === item.id ? 'text-white' : 'text-slate-500 hover:text-slate-300'}`}
          title={item.label}
        >
          {item.icon}
          {current === item.id && <div className="absolute left-0 top-1/4 bottom-1/4 w-1 bg-blue-500 rounded-r shadow-[0_0_8px_rgba(59,130,246,0.8)]" />}
        </button>
      ))}
    </div>
  );
};

// --- 4. アウトラインノード (再帰的コンポーネント) ---

function OutlineNode({ 
  node, onToggle, onDelete, onUpdate, onToggleCollapse, 
  onNodeClick, onAddChild, lastClickedId
}) {
  const isSelected = lastClickedId === node.id;
  const isTask = node.type === 'task';

  const handleKeyDown = (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      // Enterで子タスクを追加
      onAddChild(node.id);
    }
  };

  return (
    <div className="flex flex-col text-left group" id={node.id}>
      <div 
        onClick={(e) => { e.stopPropagation(); onNodeClick(node.id); }}
        className={`flex items-center gap-2 py-1.5 px-3 rounded-lg transition-all cursor-pointer border ${isSelected ? 'bg-blue-50 border-blue-200 shadow-sm' : 'border-transparent hover:bg-slate-50'}`}
      >
        <div className="flex items-center shrink-0">
          {node.children?.length > 0 ? (
            <button onClick={(e) => { e.stopPropagation(); onToggleCollapse(node.id); }} className="p-1 text-slate-400 hover:text-slate-700">
              {node.collapsed ? <ChevronRight size={14} /> : <LucideChevronDown size={14} />}
            </button>
          ) : <div className="w-6" />}
          
          {isTask ? (
            <button onClick={(e) => { e.stopPropagation(); onToggle(node.id); }} className={`p-1 transition-all ${node.completed ? 'text-emerald-500' : 'text-slate-300 hover:text-slate-400'}`}>
              {node.completed ? <CheckCircle2 size={18} /> : <Circle size={18} />}
            </button>
          ) : (
            <div className={`p-1 ${node.isRoot ? 'text-slate-900' : 'text-blue-500'}`}>
              <HelpCircle size={18} />
            </div>
          )}
        </div>

        <div className="flex-1 flex items-center gap-2 overflow-hidden text-left">
          <input 
            id={`input-${node.id}`}
            value={String(node.text || "")} 
            onChange={(e) => onUpdate(node.id, { text: e.target.value })}
            onKeyDown={handleKeyDown}
            className={`flex-1 bg-transparent border-none outline-none text-sm font-bold truncate ${node.completed ? 'text-slate-400 line-through font-normal' : 'text-slate-700'} ${node.isRoot ? 'text-base font-black' : ''}`}
            placeholder={isTask ? "タスク名を入力..." : "イシュー名を入力..."}
          />
          
          {isTask && (
            <input 
              type="date"
              value={node.deadline || TODAY_ISO}
              onChange={(e) => onUpdate(node.id, { deadline: e.target.value })}
              className="text-[10px] text-slate-400 bg-transparent border-none outline-none font-bold hover:text-blue-600 cursor-pointer w-28 text-right"
            />
          )}
          {!isTask && !node.isRoot && (
            <span className="text-[8px] font-black text-blue-400 border border-blue-100 px-1.5 rounded uppercase tracking-tighter bg-blue-50/50">Issue</span>
          )}
        </div>

        <div className="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity shrink-0">
          <button 
            onClick={(e) => { e.stopPropagation(); onUpdate(node.id, { type: isTask ? 'issue' : 'task', deadline: isTask ? null : TODAY_ISO }); }}
            className={`p-1.5 rounded-lg text-[10px] font-black transition-all ${isTask ? 'bg-slate-100 text-slate-500 shadow-inner' : 'bg-blue-600 text-white shadow-sm'}`}
            title={isTask ? "イシューに変換" : "タスクに変換"}
          >
            {isTask ? 'T' : 'I'}
          </button>
          <button onClick={(e) => { e.stopPropagation(); onAddChild(node.id); }} className="p-1.5 text-slate-400 hover:text-slate-600">
            <Plus size={16} />
          </button>
          <button onClick={(e) => { e.stopPropagation(); onDelete(node.id); }} className="p-1.5 text-slate-300 hover:text-red-500">
            <Trash2 size={16} />
          </button>
        </div>
      </div>

      {!node.collapsed && node.children?.length > 0 && (
        <div className="ml-6 pl-2 border-l border-slate-100 py-1 space-y-0.5">
          {node.children.map((child) => (
            <OutlineNode 
              key={child.id} node={child}
              onToggle={onToggle} onDelete={onDelete} onUpdate={onUpdate} 
              onToggleCollapse={onToggleCollapse} onNodeClick={onNodeClick} 
              onAddChild={onAddChild} lastClickedId={lastClickedId}
            />
          ))}
        </div>
      )}
    </div>
  );
}

// --- 5. 週間・月間ビュー ---

const WeeklyListView = ({ tasks, onTaskClick, onUpdateTask }) => {
  const actionableTasks = useMemo(() => tasks.filter(t => t.type === 'task'), [tasks]);
  const handleDrop = (e, targetId) => { e.preventDefault(); const id = e.dataTransfer.getData('taskId'); if (id) onUpdateTask(id, { deadline: targetId }); };

  return (
    <div className="h-full flex flex-col p-8 bg-slate-100/50 overflow-hidden text-left">
      <div className="mb-6 flex items-center gap-3">
        <div className="p-2 bg-slate-800 text-white rounded-xl shadow-lg"><ListTodo size={20} /></div>
        <h2 className="text-xl font-black text-slate-800">Weekly Timeline</h2>
      </div>
      <div className="flex-1 flex gap-4 overflow-hidden">
        {WEEKLY_DAYS.map(day => {
          const dayTasks = actionableTasks.filter(t => t.deadline === day.id);
          const isToday = day.id === TODAY_ISO;
          return (
            <div key={day.id} onDragOver={e => e.preventDefault()} onDrop={e => handleDrop(e, day.id)} className={`flex flex-col flex-1 min-w-[240px] rounded-[2rem] border-2 transition-all ${isToday ? 'bg-white border-blue-500 shadow-2xl ring-8 ring-blue-500/5' : 'bg-slate-50 border-slate-200'}`}>
              <div className="p-5 border-b flex items-center justify-between shrink-0 text-left">
                <div>
                  <span className={`text-[10px] font-black uppercase ${isToday ? 'text-blue-600' : 'text-slate-400'}`}>{String(day.sub)}</span><br/>
                  <span className={`text-lg font-black ${isToday ? 'text-slate-800' : 'text-slate-500'}`}>{String(day.label)}</span>
                </div>
                <span className={`px-2 py-1 rounded-lg text-xs font-black ${isToday ? 'bg-blue-600 text-white' : 'bg-slate-200 text-slate-500'}`}>{dayTasks.length}</span>
              </div>
              <div className="flex-1 p-3 space-y-2 overflow-y-auto no-scrollbar text-left">
                {dayTasks.map(task => (
                  <div key={task.id} draggable onDragStart={e => e.dataTransfer.setData('taskId', task.id)} onClick={() => onTaskClick(task.id)} className={`group flex flex-col p-3.5 rounded-2xl border transition-all cursor-grab hover:shadow-md ${task.completed ? 'opacity-40 grayscale border-transparent' : 'bg-white border-slate-100 hover:border-blue-200 shadow-sm'}`}>
                    <span className="text-[8px] font-black uppercase px-1.5 py-0.5 rounded-full bg-slate-100 text-slate-500 mb-1 inline-block w-fit">{String(task.parentText || "Project")}</span>
                    <p className="text-[13px] font-bold text-slate-800 leading-tight">{String(task.text || "")}</p>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
};

const MonthlyOverview = ({ tasks, onTaskClick, onUpdateTask }) => {
  const [viewDate, setViewDate] = useState(new Date());
  const year = viewDate.getFullYear();
  const month = viewDate.getMonth();
  const calendarDays = [];
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const firstDay = new Date(year, month, 1).getDay();
  for (let i = 0; i < firstDay; i++) calendarDays.push(null);
  for (let i = 1; i <= daysInMonth; i++) calendarDays.push(new Date(year, month, i));

  const actionableTasks = useMemo(() => tasks.filter(t => t.type === 'task'), [tasks]);

  return (
    <div className="h-full flex flex-col bg-white overflow-hidden text-left">
      <div className="p-6 border-b flex items-center justify-between shrink-0 text-left">
        <h2 className="text-xl font-black">{year}年 {month + 1}月</h2>
        <div className="flex gap-2 text-left">
          <button onClick={() => setViewDate(new Date(year, month - 1, 1))} className="p-2 hover:bg-slate-100 rounded-lg transition-all text-left"><ChevronLeft size={20}/></button>
          <button onClick={() => setViewDate(new Date())} className="px-4 py-1 text-xs font-bold border rounded-lg hover:bg-slate-50">今日</button>
          <button onClick={() => setViewDate(new Date(year, month + 1, 1))} className="p-2 hover:bg-slate-100 rounded-lg transition-all text-left"><ChevronRight size={20}/></button>
        </div>
      </div>
      <div className="flex-1 grid grid-cols-7 grid-rows-6 w-full h-full border-l border-t border-slate-100 text-left">
        {['日', '月', '火', '水', '木', '金', '土'].map(d => (<div key={d} className="bg-slate-50 border-r border-b p-3 text-center text-[10px] font-black text-slate-400 uppercase">{String(d)}</div>))}
        {calendarDays.map((date, i) => {
          if (!date) return <div key={i} className="border-r border-b bg-slate-50/30" />;
          const iso = date.toISOString().split('T')[0];
          const dayTasks = actionableTasks.filter(t => t.deadline === iso);
          const isToday = iso === TODAY_ISO;
          return (
            <div key={iso} onDragOver={e => e.preventDefault()} onDrop={e => { e.preventDefault(); const id = e.dataTransfer.getData('taskId'); if (id) onUpdateTask(id, { deadline: iso }); }} className={`border-r border-b p-2 overflow-hidden transition-all ${isToday ? 'bg-blue-50/40' : 'bg-white hover:bg-slate-50'}`}>
              <span className={`text-[11px] font-black ${isToday ? 'text-blue-600 underline font-bold' : 'text-slate-400'}`}>{date.getDate()}</span>
              <div className="space-y-0.5 mt-1 overflow-hidden">
                {dayTasks.map(t => (
                  <div key={t.id} onClick={() => onTaskClick(t.id)} className={`h-1.5 w-full rounded-full transition-all ${t.completed ? 'bg-slate-200' : 'bg-blue-500'} cursor-pointer`} title={String(t.text)} />
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
};

// --- 6. メイン App コンポーネント ---

const App = () => {
  const [treeList, setTreeList] = useState(() => {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      return saved ? JSON.parse(saved) : initialData;
    } catch (e) { return initialData; }
  });
  const [viewMode, setViewMode] = useState('tree'); 
  const [lastClickedId, setLastClickedId] = useState(null);

  useEffect(() => localStorage.setItem(STORAGE_KEY, JSON.stringify(treeList)), [treeList]);

  // 更新
  const handleUpdate = useCallback((id, updates) => {
    const upd = (nodes) => nodes.map(n => n.id === id ? { ...n, ...updates } : { ...n, children: n.children ? upd(n.children) : [] });
    setTreeList(prev => upd(prev));
  }, []);

  // 完了トグル
  const toggleComplete = useCallback((id) => {
    const toggle = (nodes) => nodes.map(node => {
      if (node.id === id && node.type === 'task') {
        const next = !node.completed;
        return { ...node, completed: next, children: (node.children || []).map(c => ({ ...c, completed: next })) };
      }
      return node.children ? { ...node, children: toggle(node.children) } : node;
    });
    setTreeList(prev => toggle(prev));
  }, []);

  // 削除
  const deleteNode = useCallback((id) => {
    setTreeList(prev => {
      const del = (nodes) => nodes.filter(n => n.id !== id).map(n => ({ ...n, children: n.children ? del(n.children) : [] }));
      return del(prev);
    });
  }, []);

  // 子要素追加ロジック (ショートカット & フォーカス対応)
  const addChild = useCallback((parentId) => {
    const newId = generateId('node');
    const add = (nodes) => nodes.map(n => n.id === parentId ? { 
      ...n, 
      collapsed: false, 
      children: [...(n.children || []), { 
        id: newId, 
        text: '', 
        completed: false, 
        deadline: n.deadline || TODAY_ISO, 
        type: 'task', 
        children: [] 
      }] 
    } : { ...n, children: n.children ? add(n.children) : [] });
    
    setTreeList(prev => add(prev));
    setLastClickedId(newId);
    
    // UI反映後にフォーカス
    setTimeout(() => {
      const input = document.getElementById(`input-${newId}`);
      if (input) input.focus();
    }, 10);
  }, []);

  // フラットリスト (スケジュール用)
  const allTasksFlat = useMemo(() => {
    const list = [];
    const extract = (node, pText) => {
      if (!node.isRoot) list.push({ ...node, parentText: pText });
      if (node.children) node.children.forEach(child => extract(child, node.text));
    };
    treeList.forEach((root) => {
      if (root.children) root.children.forEach((c) => extract(c, root.text));
    });
    return list;
  }, [treeList]);

  // ショートカットキーの実装
  useEffect(() => {
    const handleKeyDown = (e) => {
      if (e.ctrlKey && e.shiftKey) { 
        e.preventDefault(); 
        setViewMode(p => p === 'tree' ? 'list' : p === 'list' ? 'monthly' : 'tree');
        return;
      }

      // 入力中は「Shift + Enter」でのルート追加のみ監視
      if (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA') {
         if (e.key === 'Enter' && e.shiftKey && viewMode === 'tree') {
            e.preventDefault();
            const newRootId = generateId('root');
            setTreeList(prev => [...prev, { id: newRootId, text: '', completed: false, deadline: null, type: 'issue', isRoot: true, collapsed: false, children: [] }]);
            setLastClickedId(newRootId);
            setTimeout(() => document.getElementById(`input-${newRootId}`)?.focus(), 10);
         }
         return;
      }

      // 非入力時のEnterで子タスク追加
      if (e.key === 'Enter' && viewMode === 'tree' && lastClickedId) {
        e.preventDefault();
        addChild(lastClickedId);
      }
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [lastClickedId, viewMode, addChild]);

  const jump = (id) => { if (id) setLastClickedId(id); setViewMode('tree'); };

  return (
    <div className="h-screen bg-white font-sans text-slate-900 flex overflow-hidden text-left">
      <Sidebar current={viewMode} onSet={setViewMode} />

      <div className="flex-1 flex flex-col overflow-hidden text-left">
        <header className="h-14 bg-white border-b flex items-center justify-between px-6 shrink-0 text-left text-left">
           <div className="flex items-center gap-3">
             <Target size={20} className="text-slate-800" />
             <h1 className="text-base font-black italic tracking-tighter text-left">Biz-Flow Outline</h1>
           </div>
           
           <div className="flex items-center gap-4 text-left">
              <div className="flex items-center gap-3 px-3 py-1 bg-slate-50 border rounded-lg text-[10px] font-bold text-slate-500 text-left">
                <span className="flex items-center gap-1 text-left"><LucideKeyboard size={12}/> Shortcuts:</span>
                <span className="bg-white px-1.5 border rounded text-left">Enter</span> 子タスク
                <span className="bg-white px-1.5 border rounded text-left">Shift+Enter</span> 新ルート
              </div>
              <div className="h-4 w-px bg-slate-200 mx-1" />
              <button onClick={() => window.print()} className="p-2 text-slate-400 hover:text-slate-600 transition-colors"><LucidePrinter size={18} /></button>
           </div>
        </header>

        <main className="flex-1 overflow-auto bg-slate-50/50 text-left">
          {viewMode === 'tree' ? (
            <div className="p-10 max-w-5xl mx-auto w-full text-left">
              <div className="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-1 text-left">
                {treeList.map(root => (
                  <OutlineNode 
                    key={root.id} node={root}
                    onToggle={toggleComplete} onDelete={deleteNode} 
                    onUpdate={handleUpdate} 
                    onToggleCollapse={id => setTreeList(prev => { 
                      const upd = d => d.id === id ? { ...d, collapsed: !d.collapsed } : { ...d, children: (d.children || []).map(upd) }; 
                      return prev.map(upd); 
                    })} 
                    onNodeClick={setLastClickedId} onAddChild={addChild} lastClickedId={lastClickedId}
                  />
                ))}
              </div>
              <button onClick={() => {
                const newId = generateId('root');
                setTreeList([...treeList, { id: newId, text: '', completed: false, deadline: null, type: 'issue', isRoot: true, collapsed: false, children: [] }]);
                setLastClickedId(newId);
                setTimeout(() => document.getElementById(`input-${newId}`)?.focus(), 10);
              }} className="ml-4 mt-8 flex items-center gap-2 text-slate-400 hover:text-slate-800 font-bold text-sm transition-colors text-left text-left">
                <Plus size={18}/> プロジェクト(Root)を追加
              </button>
            </div>
          ) : viewMode === 'list' ? (
            <WeeklyListView tasks={allTasksFlat} onTaskClick={jump} onUpdateTask={handleUpdate} />
          ) : (
            <MonthlyOverview tasks={allTasksFlat} onTaskClick={jump} onUpdateTask={handleUpdate} />
          )}
        </main>
      </div>
    </div>
  );
};

export default App;
